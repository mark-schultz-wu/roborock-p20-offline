# Environment-specific values for this install. Copy to `lab.env` (gitignored)
# and fill in — every tool reads it: vacuum.py, the ops scripts, the checks.
# Real environment variables override anything set here.
# The placeholders below are deliberately inert (TEST-NET addresses, zero
# keys) so offline unit tests pass on a fresh clone.

# --- your robot -------------------------------------------------------------
# VACUUM_HOST: its DHCP lease on the AP subnet (dnsmasq.log / `ip neigh`).
# VACUUM_KEY/VACUUM_DUID: the localKey/duid from provisioning (see
# provisioning/PROTOCOL.md); they also land in .cloud_session.json.
VACUUM_HOST=192.0.2.30
VACUUM_KEY=0000000000000000
VACUUM_DUID=0000000000000000
VACUUM_PID=roborock.vacuum.a184

# --- the isolated AP this machine hosts for the robot ------------------------
# AP_IP: this machine's address on uap0; the stack publishes :443 on it.
# AP_IFACE: the virtual AP interface; LAN_IFACE: your Wi-Fi station interface.
# The robot is 2.4 GHz-only, so the LAN interface must sit on a 2.4 GHz cell.
AP_IP=192.0.2.1
AP_IFACE=uap0
LAN_IFACE=wlo1
WIFI_SSID=roborock-lab
WIFI_PASS=changeme

# --- the local "cloud" stack ------------------------------------------------
# Must match local_roborock_server/config.toml ([network] stack_fqdn, ports)
# and the token.r you provisioned the robot with (stack/config.example.toml).
# TOKEN_HOST is the host part of token.r without scheme or trailing slash;
# the firmware dials its first 15 chars + "iot.roborock.com" (camera bootstrap).
STACK_HOST=api-rr.roborock.lab
TOKEN_HOST=rr.roborock.lab
STACK_PORT=555
MQTT_PORT=8881

# --- protocol login on the stack ---------------------------------------------
# [admin] protocol_login_email / protocol_login_pin in config.toml —
# used by vacuum_map.py, web/server.py and Home Assistant/LocalRock.
PROTOCOL_EMAIL=roborock@roborock.lab
PROTOCOL_PIN=000000

# --- operator notes (nothing reads these; lab.env is the one gitignored
# place to keep them) --------------------------------------------------------
# ADMIN_USER=your stack admin login (local_roborock_server admin UI)
# CAMERA_PIN=the remote-view PIN set on the robot (set_homesec_password)
